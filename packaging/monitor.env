# Package defaults. Edit here, then run: sudo systemctl restart linux-monitor
# This port is separate from the development backend (8000) and nginx (8080).
MONITOR_BACKEND_HOST=127.0.0.1
MONITOR_BACKEND_PORT=8765
MONITOR_DATABASE_PATH=/var/lib/linux-monitor/monitor.db
MONITOR_FRONTEND_DIR=/usr/share/linux-monitor/dashboard
# Monitor the installed service by default; add ssh,docker,etc. if needed.
MONITOR_MONITORED_SERVICES=linux-monitor
