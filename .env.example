# Copy this file to `.env` (repo root or backend/) and adjust.
# `.env` is git-ignored - never commit real values.
#
# Precedence (highest wins): real environment variables > .env > config/monitor.yaml > defaults.
# List values are comma-separated.

# --- Logging ---
MONITOR_LOG_LEVEL=INFO          # DEBUG | INFO | WARNING | ERROR | CRITICAL
MONITOR_LOG_FORMAT=json         # json | text

# --- Collection ---
MONITOR_POLLING_INTERVAL_SECONDS=10
MONITOR_TOP_PROCESSES_COUNT=5

# Filesystem types ignored by the disk collector.
# Remove `9p` if you want WSL to report Windows drives (/mnt/c) as well.
MONITOR_DISK_EXCLUDE_FSTYPES=tmpfs,devtmpfs,squashfs,overlay,proc,sysfs,cgroup,cgroup2,devpts,securityfs,debugfs,tracefs,configfs,fusectl,pstore,bpf,autofs,mqueue,hugetlbfs,ramfs,binfmt_misc,nsfs,efivarfs,9p,drvfs,fuse.*

# Alternative YAML file location (must be a real env var, not set via .env):
# MONITOR_CONFIG_FILE=/path/to/monitor.yaml
