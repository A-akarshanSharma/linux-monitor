[Unit]
Description=Linux Server Monitoring & Alerting Platform - backend
After=network.target

[Service]
Type=simple
WorkingDirectory=__BACKEND_DIR__
ExecStart=__VENV_DIR__/bin/python -m app
Restart=on-failure
RestartSec=5
# Uncomment to run as a dedicated non-root user instead of whoever installs it:
# User=monitor
# Group=monitor

[Install]
WantedBy=multi-user.target
